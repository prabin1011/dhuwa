
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Lock down the entire /users/{userId} path and all its subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Separately, manage the public username directory
    match /usernames/{uname} {
      // Allow anyone to read a username document to resolve a username to a UID.
      // This is necessary for the "sign in with username" feature.
      allow get: if true;

      // Only allow a user to create their own username document.
      // - The user must be signed in.
      // - The UID in the document must match the user's own UID.
      // - The document ID (the lowercase username) must match the username in the doc.
      // - The username document must not already exist (ensuring uniqueness).
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.usernameLower == uname
                    && !exists(/databases/$(database)/documents/usernames/$(uname));

      // Do not allow anyone to update or delete username records.
      allow update, delete: if false;
    }
  }
}
