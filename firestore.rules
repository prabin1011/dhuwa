/**
 * @fileoverview Firestore Security Rules for Dhuwa App
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, where each signed-in user
 * can only read and write their own data. This ensures data privacy and prevents
 * unauthorized access. The community_posts collection is an exception, allowing
 * global read and specific write/update access for authenticated users.
 *
 * Data Structure:
 * - /users/{userId}:  Each user has a single profile document identified by their UID.
 * - /users/{userId}/urges/{urgeId}:  Each user has a subcollection of urge entries.
 * - /users/{userId}/notifications/{notificationId}: Each user has a subcollection of notifications.
 * - /community_posts/{postId}: A global collection of public posts.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied by the structure (no top-level collection).
 * - The rules explicitly deny any read or write access if the user is not authenticated.
 * - Data shape is not strictly validated to allow for rapid prototyping and iteration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to a user's profile only to the authenticated user with the matching UID.
     * @path /users/{userId}
     * @allow (read, write) if request.auth != null && request.auth.uid == userId - Allows a logged-in user to read and write their own profile.
     * @deny (read, write) if request.auth == null - Denies access to users who are not logged in.
     * @deny (read, write) if request.auth.uid != userId - Denies access to another user's profile.
     * @principle Enforces document ownership for all read and write operations.
     */
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * @description Grants access to a user's urges subcollection only to the authenticated user with the matching UID.
     * @path /users/{userId}/urges/{urgeId}
     * @allow (read, write) if request.auth != null && request.auth.uid == userId - Allows a logged-in user to manage their own urge entries.
     * @deny (read, write) if request.auth == null - Denies access to users who are not logged in.
     * @deny (read, write) if request.auth.uid != userId - Denies access to another user's urge entries.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/urges/{urgeId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

      /**
       * @description Grants access to a user's notifications subcollection only to the authenticated user with the matching UID.
       * @path /users/{userId}/notifications/{notificationId}
       * @allow (read, write) if request.auth != null && request.auth.uid == userId - Allows a logged-in user to manage their own notifications.
       * @deny (read, write) if request.auth == null - Denies access to users who are not logged in.
       * @deny (read, write) if request.auth.uid != userId - Denies access to another user's notifications.
       * @principle Restricts access to a user's own data tree.
       */
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for the global community feed.
     * @path /community_posts/{postId}
     * @principle Allows any authenticated user to read all posts and create new ones.
     *            Users can only delete their own posts.
     *            Users can only update the 'likes' and 'likeIds' fields.
     */
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeIds'])
                    && isLikingOrUnliking(request.resource.data.likeIds, resource.data.likeIds, request.auth.uid)
                    && request.resource.data.likes == request.resource.data.likeIds.size();
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  // Ensures a user is only adding/removing their own ID from the likeIds array.
  function isLikingOrUnliking(newLikeIds, oldLikeIds, authId) {
    let liking = newLikeIds.size() == oldLikeIds.size() + 1 && newLikeIds.hasAll(oldLikeIds) && newLikeIds.hasAny([authId]);
    let unliking = newLikeIds.size() == oldLikeIds.size() - 1 && oldLikeIds.hasAll(newLikeIds) && oldLikeIds.hasAny([authId]);
    return liking || unliking;
  }
}
