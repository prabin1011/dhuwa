/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only access
 * their own data, preventing unauthorized access to other users' information.
 *
 * Data Structure:
 * - /users/{userId}: Public profile information for each user.
 * - /users/{userId}/profile/main: User's app-specific profile and settings (singleton).
 * - /users/{userId}/urges/{urgeId}: Smoking urges logged by a specific user.
 * - /users/{userId}/notifications/{notificationId}: Notifications sent to the user.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent enumeration.
 * - Ambiguous or missing relationships default to owner-only access.
 *
 * Denormalization for Authorization:
 *  - The rules rely on the `request.auth.uid` to match the `userId` in the path,
 *    ensuring that users can only access data associated with their own account.
 *
 * Structural Segregation:
 *  - User-specific data is stored under the `/users/{userId}` path, clearly
 *    segregating user data and enforcing the ownership model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the /users/{userId} collection, allowing read access and owner-only create.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get) Authenticated user can read the user profile
     * @allow (create) Authenticated user can create their own profile
     * @deny (update) Authenticated user cannot update another user's profile
     * @deny (delete) Authenticated user cannot delete another user's profile
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Disallow user listing.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if false;
    }

    /**
     * @description Protects the /users/{userId}/profile/main document, enforcing owner-only access.
     * @path /databases/{database}/documents/users/{userId}/profile/main
     * @allow (get) Authenticated user can read their own profile.
     * @allow (create) Authenticated user can create their own profile.
     * @allow (update) Authenticated user can update their own profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (get) Authenticated user cannot read another user's profile.
     * @deny (create) Authenticated user cannot create another user's profile.
     * @deny (update) Authenticated user cannot update another user's profile.
     * @deny (delete) Authenticated user cannot delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/profile/main {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects the /users/{userId}/urges/{urgeId} collection, enforcing owner-only access.
     * @path /databases/{database}/documents/users/{userId}/urges/{urgeId}
     * @allow (create) Authenticated user can create an urge entry in their own profile.
     * @allow (get) Authenticated user can read an urge entry in their own profile.
     * @allow (update) Authenticated user can update an urge entry in their own profile.
     * @allow (delete) Authenticated user can delete an urge entry in their own profile.
     * @deny (create) Authenticated user cannot create an urge entry in another user's profile.
     * @deny (get) Authenticated user cannot read an urge entry in another user's profile.
     * @deny (update) Authenticated user cannot update an urge entry in another user's profile.
     * @deny (delete) Authenticated user cannot delete an urge entry in another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/urges/{urgeId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    /**
     * @description Protects the /users/{userId}/notifications/{notificationId} collection, enforcing owner-only access.
     * @path /databases/{database}/documents/users/{userId}/notifications/{notificationId}
     * @allow (create) Authenticated user can create an notification entry in their own profile.
     * @allow (get) Authenticated user can read an notification entry in their own profile.
     * @allow (list) Authenticated user can list notification entries in their own profile.
     * @allow (update) Authenticated user can update an notification entry in their own profile.
     * @allow (delete) Authenticated user can delete an notification entry in their own profile.
     * @deny (create) Authenticated user cannot create an notification entry in another user's profile.
     * @deny (get) Authenticated user cannot read an notification entry in another user's profile.
     * @deny (update) Authenticated user cannot update an notification entry in another user's profile.
     * @deny (delete) Authenticated user cannot delete an notification entry in another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if false; //Notifications are only created by the server.
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}