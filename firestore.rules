/**
 * @fileoverview Firestore Security Rules for Dhuwa App
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, where each signed-in user
 * can only read and write their own data. This ensures data privacy and prevents
 * unauthorized access. The community_posts collection is an exception, allowing
 * global read and specific write/update access for authenticated users.
 *
 * Data Structure:
 * - /users/{userId}:  Each user has a single profile document identified by their UID.
 * - /users/{userId}/urges/{urgeId}:  Each user has a subcollection of urge entries.
 * - /users/{userId}/notifications/{notificationId}: Each user has a subcollection of notifications.
 * - /community_posts/{postId}: A global collection of public posts.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied by the structure (no top-level collection).
 * - The rules explicitly deny any read or write access if the user is not authenticated.
 * - Data shape is not strictly validated to allow for rapid prototyping and iteration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Users tree as you already have
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/urges/{urgeId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/notifications/{id} {
      allow read, write: if isOwner(userId);
    }

    // Community posts
    match /community_posts/{postId} {
      allow read: if signedIn();

      // Create your own post
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
            'userId','username','habit','activity','momentLabel',
            'createdAt','likeIds','likesCount','commentsCount'
          ]);

      // Delete your own post
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Only allow toggling likes safely
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['likeIds','likesCount','commentsCount'])
        && validLikeToggle(resource.data.likeIds, request.resource.data.likeIds, request.auth.uid)
        && request.resource.data.likesCount == request.resource.data.likeIds.size();
    }

    match /community_posts/{postId}/comments/{commentId} {
      allow read: if signedIn();

      // Create your own comment
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId','username','text','parentId','createdAt']);

      // Delete your own comment
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

function validLikeToggle(oldIds, newIds, me) {
  // add my id OR remove my id — nothing else
  return
    (newIds.size() == oldIds.size() + 1 && newIds.hasAll(oldIds) && newIds.hasAny([me])) ||
    (newIds.size() == oldIds.size() - 1 && oldIds.hasAll(newIds) && oldIds.hasAny([me]));
}
