/**
 * @fileoverview Firestore Security Rules for Quit Tracker App
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model. Each user has a dedicated data tree under `/users/{userId}` which only they can access.
 *
 * Data Structure:
 * - `/users/{userId}`: User account information. Only the user can read or write their own account data.
 * - `/users/{userId}/profile/main`: User profile settings.  Only the user can read or write their own profile.
 * - `/users/{userId}/urges/{urgeId}`: Collection of user-logged urges. Only the user can read, create, update, or delete urges they own.
 *
 * Key Security Decisions:
 * - Users can only access their own data.
 * - Listing of all users is disallowed.
 *
 * Denormalization for Authorization:  The rules rely on the `request.auth.uid` matching the `userId` in the path to establish ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the user account document.
     * @path /users/{userId}
     * @allow (create) User with matching ID can create their account.
     * @allow (get, update, delete) User with matching ID can get, update, and delete their account.
     * @deny (create) User cannot create an account with a mismatched ID.
     * @deny (get, update, delete) User cannot get, update, or delete another user's account.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to the user's profile document.
     * @path /users/{userId}/profile/main
     * @allow (get, create, update, delete) User with matching ID can access their profile.
     * @deny (get, create, update, delete) User cannot access another user's profile.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/profile/main {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to the user's urge entries.
     * @path /users/{userId}/urges/{urgeId}
     * @allow (get, list, create, update, delete) User with matching ID can manage their own urges.
     * @deny (get, list, create, update, delete) User cannot manage another user's urges.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/urges/{urgeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}