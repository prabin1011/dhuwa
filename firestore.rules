/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for all data. Each user can only access their own profile data and the urges they have logged.
 *
 * Data Structure:
 * - /users/{userId}: Stores public profile information for each user.
 * - /users/{userId}/profile/main: A singleton document storing the user's app-specific profile and settings.
 * - /users/{userId}/urges/{urgeId}: A collection of all smoking urges logged by a specific user.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All write operations are restricted to the owner of the data.
 *
 * Denormalization for Authorization:
 * - User IDs are embedded in the document paths to enforce ownership, avoiding the need for `get()` calls to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and create their public profile.
     * @path /users/{userId}
     * @allow (get, create) if request.auth.uid == userId
     * @deny (update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes. Allows self-creation.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows a user to read and modify their app-specific profile settings.
     * @path /users/{userId}/profile/main
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny If the authenticated user ID does not match the userId in the path.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/profile/main {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows a user to read and modify their smoking urge logs.
     * @path /users/{userId}/urges/{urgeId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny If the authenticated user ID does not match the userId in the path.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/urges/{urgeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}