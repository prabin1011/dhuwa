
rules_version = '2';
service cloud.firestore {
  function signedIn() { return request.auth != null; }
  function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

  match /databases/{database}/documents {

    // ===== Private user tree =====
    match /users/{userId}/{doc=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Rule for wearable data: measurements, detections
    match /users/{userId}/measurements/{docId} {
      allow create, read: if isOwner(userId);
    }
    match /users/{userId}/detections/{docId} {
      allow create, read, update: if isOwner(userId);
    }

    // ===== Community: readable to signed-in users =====
    match /community_posts/{document=**} {
      allow read: if signedIn();
    }

    // ----- Posts -----
    match /community_posts/{postId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId','username','habit','activity','momentLabel',
          'createdAt','likeIds','likesCount','commentsCount'
        ]);

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      
      // Allow liking and unliking
      allow update: if signedIn()
          && request.resource.data.keys().hasAll(resource.data.keys())
          && request.resource.data.keys().hasAny(['likesCount', 'likeIds'])
          && request.resource.data.likesCount == request.resource.data.likeIds.size()
          && (
            // Like: adding self to likeIds
            request.resource.data.likeIds == resource.data.likeIds.concat([request.auth.uid])
            || 
            // Unlike: removing self from likeIds
            request.resource.data.likeIds == resource.data.likeIds.remove([request.auth.uid])
          );
    }
    
    // ---- Comments ----
    match /community_posts/{postId}/comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}

    