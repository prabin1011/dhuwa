/**
 * @fileoverview Firestore Security Rules for Dhuwa App
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for private data, while
 * enabling a secure, read-only public community feed.
 *
 * Key Security Decisions:
 * - User data is strictly private (/users/{userId}).
 * - The community feed (/community_posts) is readable by any authenticated user.
 * - Writes to the community feed are tightly controlled:
 *   - Users can only create posts for themselves.
 *   - Likes are atomic (you can only add/remove your own UID).
 *   - Comment counts can only be incremented.
 */
rules_version = '2';
service cloud.firestore {

  // =================================
  //           HELPERS
  // =================================
  function signedIn() { return request.auth != null; }
  function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

  // True if you're adding/removing your own UID from likeIds.
  function validLikeToggle(oldIds, newIds, me) {
    return
      (newIds.size() == oldIds.size() + 1 && newIds.hasAll(oldIds) && newIds.hasAny([me])) ||
      (newIds.size() == oldIds.size() - 1 && oldIds.hasAll(newIds) && oldIds.hasAny([me]));
  }


  // =================================
  //           RULES
  // =================================
  match /databases/{database}/documents {

    // ===== Private user tree =====
    match /users/{userId}/{doc=**} {
      allow read, write: if isOwner(userId);
    }

    // ===== Community: readable to signed-in users =====
    match /community_posts/{document=**} {
      allow read: if signedIn();
    }

    // ----- Posts -----
    match /community_posts/{postId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId','username','habit','activity','momentLabel',
          'createdAt','likeIds','likesCount','commentsCount'
        ]);

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Split the update paths:
      allow update: if signedIn() && (
        // (A) Like/unlike
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['likeIds','likesCount']) &&
          validLikeToggle(resource.data.likeIds, request.resource.data.likeIds, request.auth.uid) &&
          request.resource.data.likesCount == request.resource.data.likeIds.size()
        )
        ||
        // (B) Only increment/decrement commentsCount (batched with comment create/delete)
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['commentsCount']) &&
          (
            request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
            request.resource.data.commentsCount == resource.data.commentsCount - 1
          )
        )
      );
    }
    
    // ----- Commenters marker: one comment per user per post -----
    // We require creating /community_posts/{postId}/commenters/{uid} exactly once
    // and only by the same uid (used in a batch with the comment).
    match /community_posts/{postId}/commenters/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && !exists(/databases/$(database)/documents/community_posts/$(postId)/commenters/$(uid));
      allow read: if signedIn();
      allow delete: if false; // we don't need to delete markers
      allow update: if false;
    }

    // ----- Comments -----
    match /community_posts/{postId}/comments/{commentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        // Not allowed to comment on your own post
        && get(/databases/$(database)/documents/community_posts/$(postId)).data.userId != request.auth.uid
        // Field validation
        && request.resource.data.keys().hasAll(['userId','username','text','parentId','createdAt'])
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280;

      // Allow the author to delete their own comment (will batch a -1 on commentsCount)
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // We do not allow updates to comment bodies.
      allow update: if false;
    }
  }
}
